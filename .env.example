# ─── APP ───────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=lumi_db
# Dentro de Docker: host = nombre del servicio (postgres), puerto interno 5432
DATABASE_URL=postgresql://postgres:root@postgres:5432/lumi_db?schema=public

# ─── JWT ───────────────────────────────────────
JWT_SECRET=change-me-min-64-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-64-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── BCRYPT ───────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── LUMI ─────────────────────────────────────
# URL pública del backend (usada para generar install.sh del agente)
LUMI_PUBLIC_URL=http://localhost:3000

# ─── Rate Limiting ────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ─── SMTP (fase futura) ──────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# SMTP_FROM_NAME="LUMI Guardián AI"
# SMTP_FROM_EMAIL="noreply@lumi.io"
