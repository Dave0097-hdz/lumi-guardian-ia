# ─── Variables de PRODUCCIÓN del sistema central ─────────────────────────
# Copia este archivo a .env.production y completa los valores reales.
# NUNCA subas .env.production al repositorio (ya está en .gitignore).

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# URL pública única (frontend y backend comparten origen detrás de Nginx).
# Con un solo dominio, CORS y cookies HttpOnly funcionan sin fricción.
LUMI_PUBLIC_URL=https://lumi.example.com
FRONTEND_URL=https://lumi.example.com

# ── PostgreSQL ───────────────────────────────────────────────────────────
# El host es el nombre del servicio en el compose ("postgres"), no localhost.
POSTGRES_USER=lumi
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=lumi
DATABASE_URL=postgresql://lumi:cambia_esta_password@postgres:5432/lumi?schema=public

# ── JWT ──────────────────────────────────────────────────────────────────
# Genera secretos largos y aleatorios (mín. 32 chars). Ej: openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_32_chars
JWT_REFRESH_SECRET=genera_otro_secreto_distinto_de_al_menos_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Bcrypt ───────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ── Logs ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PRISMA_LOG_QUERIES=false

# ── Correo (SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_usuario_smtp
EMAIL_PASSWORD=tu_password_smtp
SMTP_FROM_NAME=LUMI Guardián AI
SMTP_FROM_EMAIL=noreply@lumi.example.com
