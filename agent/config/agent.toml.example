[agent]
version = "0.1.0"

[logging]
level = "INFO"
file = "logs/agent.log"

[storage]
db_path        = "data/lumi.db"
max_size_mb    = 500
retention_days = 30

[sensors]
system_interval_seconds = 5
log_batch_size          = 100

[control]
enabled = true
bind_host = "127.0.0.1"
puerto = 9000
permitir_privadas = true
whitelist_ip = []